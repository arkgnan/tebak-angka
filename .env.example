# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Salin file ini menjadi `.env` untuk menjalankan konfigurasi lokal Anda sendiri:
#   cp .env.example .env
# ==============================================================================

# Google Sign-In Web Client ID (Ganti dengan Web Client ID dari Google Cloud Console Anda)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id-here.apps.googleusercontent.com

# Google AdMob IDs
# Secara default menggunakan Google Test IDs resmi agar aman dari penalti AdMob.
# Ganti dengan ID unit produksi Anda sendiri hanya jika Anda siap merilis build pribadi.
EXPO_PUBLIC_ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_REWARDED_ID=ca-app-pub-3940256099942544/5224354917
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712
EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-3940256099942544/6300978111
